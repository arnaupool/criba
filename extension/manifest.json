{
  "manifest_version": 3,
  "name": "Criba · cookies",
  "version": "1.0.0",
  "description": "Envía a tu Criba las cookies de Instagram y X cuando cambian, para no tener que subir el cookies.txt a mano.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["*://*.instagram.com/*", "*://*.x.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Criba · cookies",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "criba-cookies@arnaupool",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  }
}
